# IUEA Community Radio — optional pre-configuration for hosted deploys (Vercel / Pages).
# In-app Settings entries override these per device.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: your real broadcast stream (Icecast / Zeno.fm / Radio.co ...).
# Without it the station plays the built-in studio demo mix so the app is never silent.
VITE_STREAM_URL=
